{
  "name": "prismstructure",
  "version": "1.0.0",
  "description": "Playwright UI + API automation for Practice Software Testing Toolshop",
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:all:report": "playwright test && playwright show-report reports/playwright/html",
    "test:ui": "playwright test playwright/tests/ui",
    "test:ui:headed": "playwright test playwright/tests/ui --headed",
    "test:api": "playwright test playwright/tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:report": "playwright show-report reports/playwright/html"
  },
  "keywords": ["playwright", "qa", "toolshop"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
